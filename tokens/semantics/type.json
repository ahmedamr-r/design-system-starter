{
  "type": {
    "family": { "$type": "fontFamily", "$value": "{font.family.sans}", "$description": "Every piece of text." },
    "title": {
      "size": { "$type": "dimension", "$value": "{font.size.500}", "$description": "Card and section titles." },
      "weight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" }
    },
    "body": {
      "size": { "$type": "dimension", "$value": "{font.size.300}", "$description": "Paragraphs and most text." },
      "weight": { "$type": "fontWeight", "$value": "{font.weight.regular}" },
      "line-height": { "$type": "number", "$value": "{font.line-height.150}", "$description": "Text that may run onto a second line: paragraphs, lists and buttons. A single line set tight, such as a tag or a price, uses 1 and reads no token." }
    },
    "label": {
      "size": { "$type": "dimension", "$value": "{font.size.200}", "$description": "Buttons, tags and small labels." },
      "weight": { "$type": "fontWeight", "$value": "{font.weight.medium}" }
    }
  }
}
