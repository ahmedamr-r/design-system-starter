{
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"]
      },
      "arabic": {
        "$type": "fontFamily",
        "$description": "IBM Plex Sans Arabic for Arabic letters, then the system face. The demo loads only its Arabic letters, so Latin letters and digits fall through to the system face.",
        "$value": ["IBM Plex Sans Arabic", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"]
      }
    },
    "size": {
      "$type": "dimension",
      "200": { "$value": { "value": 14, "unit": "px" } },
      "300": { "$value": { "value": 16, "unit": "px" } },
      "400": { "$value": { "value": 20, "unit": "px" } },
      "500": { "$value": { "value": 24, "unit": "px" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    },
    "line-height": {
      "$type": "number",
      "$description": "Line heights as plain numbers, multiples of the font size, so each follows whatever size it is used with. Steps are named by the number times 100, so 150 is 1.5.",
      "150": { "$value": 1.5 },
      "170": { "$value": 1.7 }
    }
  }
}
